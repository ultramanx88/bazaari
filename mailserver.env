# General Settings
OVERRIDE_HOSTNAME=mail.bazaari.com
POSTMASTER_ADDRESS=postmaster@bazaari.com

# SSL/TLS Settings
SSL_TYPE=letsencrypt
LETSENCRYPT_HOST=mail.bazaari.com
LETSENCRYPT_EMAIL=admin@bazaari.com

# Authentication
ENABLE_SASLAUTHD=1
SASLAUTHD_MECHANISMS=rimap
SASLAUTHD_MECH_OPTIONS=127.0.0.1

# Security
ENABLE_FAIL2BAN=1
FAIL2BAN_BLOCKTYPE=drop
ENABLE_SPAMASSASSIN=1
ENABLE_CLAMAV=1
ENABLE_AMAVIS=1

# DKIM/SPF/DMARC
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1

# Dovecot Settings
ENABLE_IMAP=1
ENABLE_POP3=0
ENABLE_MANAGESIEVE=1

# Postfix Settings
POSTFIX_MESSAGE_SIZE_LIMIT=52428800  # 50MB
ENABLE_POSTFIX_VIRTUAL_TRANSPORT=1

# Logging
LOG_LEVEL=info
SUPERVISOR_LOGLEVEL=info

# Network
NETWORK_INTERFACE=eth0
DMS_DEBUG=0

# Accounts (will be created automatically)
# Format: user@domain.com|password
ACCOUNTS=|
  admin@bazaari.com|admin_password_here
  partners@bazaari.com|partners_password_here
  noreply@bazaari.com|noreply_password_here
  support@bazaari.com|support_password_here